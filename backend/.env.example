# Server
PORT=3001
NODE_ENV=development
# Comma-separated browser origins allowed in production (native clients send no Origin)
CORS_ALLOWED_ORIGINS=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model overrides (optional, sensible defaults in src/agents/modelFactory.ts)
SUPERVISOR_MODEL=
PLANNER_MODEL=
PLANNER_BATCH_MODEL=
EDITOR_MODEL=
ANALYST_MODEL=
MEMORY_MODEL=
NUTRITION_MODEL=
NUTRITION_VISION_MODEL=
NUTRITION_VISION_FIX_MODEL=
CHAT_FALLBACK_MODEL=
EMBEDDING_MODEL=
ENRICHMENT_MODEL=
MODERATION_MODEL=
VOICE_MODEL=
VOICE_NAME=

# Feature flags
MODERATION_ENABLED=true
PHOTO_LOGGING_ENABLED=true

# Subscriptions (RevenueCat)
REVENUECAT_PROJECT_ID=
REVENUECAT_V2_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Analytics / monitoring
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
