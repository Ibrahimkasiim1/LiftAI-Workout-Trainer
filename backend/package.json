{
  "name": "liftai-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/backend/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "studio": "tsx watch src/studio.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/backend/src/server.js",
    "start:render": "tsx src/server.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "SUPABASE_URL=http://localhost:54321 SUPABASE_ANON_KEY=test SUPABASE_SERVICE_ROLE_KEY=test tsx --test src/__tests__/*.test.ts",
    "trace:chat-stream": "tsx scripts/trace-chat-stream.ts",
    "test:one-off-mock": "tsx scripts/one-off-workout-mock-scenarios.ts",
    "test:workout-generator": "tsx scripts/test-workout-generator.ts",
    "enrich:exercises": "tsx scripts/enrich-exercises.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.1.0",
    "@langchain/core": "^1.1.4",
    "@langchain/langgraph": "^1.0.4",
    "@langchain/langgraph-checkpoint": "^1.0.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/openai": "^1.1.3",
    "@posthog/ai": "^7.4.3",
    "@sentry/node": "^10.66.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.20.0",
    "posthog-node": "^5.21.2",
    "tsx": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3"
  }
}
