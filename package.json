{
  "name": "liftaiapp",
  "main": "expo-router/entry",
  "version": "2.1.0",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "start": "expo start",
    "data:clone:exercisedb": "node ./scripts/clone-exercisedb-api.js",
    "data:gifs:exercisedb": "node ./scripts/download-exercise-gifs.js --source ./data/exercisedb-v1-full-normalized.json --output ./data/exercisedb-v1-gifs-full",
    "data:gifs:retry-failed": "node ./scripts/download-exercise-gifs.js --source ./data/exercisedb-v1-full-normalized.json --output ./data/exercisedb-v1-gifs-full --retry-failed-only",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "backend:install": "cd backend && npm install",
    "backend:build": "cd backend && npm run build",
    "setup:backend": "npm run backend:install && echo 'Backend ready. Run npm run dev to start the Express server.'",
    "test:navguards": "node ./scripts/test-navigation-guards.mjs"
  },
